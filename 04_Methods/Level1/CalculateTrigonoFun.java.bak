
import java.util.Scanner;
import java.lang.Math;
import java.util.*;

public class CalculateTrigonoFun{
 
  // calculate using funcation.
   
  public double[] calculateTrigonometricFunctions(double angle){
	   
	  // convert degree to radian  
	  double radian = angle * 0.0174533;
	  
	  
	  // mathfuncation  -- sine -- cosine -- tangent 
	  
	  double [] arrays = new double[3];
	  /*
	   Math.sin(x);
       Math.cos(x);
       Math.tan(x);
	   
	  */
	   arrays[0] = Math.sin(radian);
	   arrays[1] = Math.cos(radian);
	   arrays[2] = Math.tan(radian);
	    
	  return arrays;
	  
   }

 
  
  // main method to start the program 
   
  public static void main(String args[]){
     
	 Scanner scanner = new Scanner(System.in);
	 
	 
	 // enter the number. 
	 System.out.println("enter the angle");
	 double angle = scanner.nextInt();
      	 
	 
	 CalculateTrigonoFun obj = new CalculateTrigonoFun();
	 
	 double  funcation_array = obj.calculateTrigonometricFunctions(angle);
	 
    
	  
	  System.out.println("The value of differnt funcation is  " + funcation_array[0] + " " + funcation_array[1] + " " + funcation_array [2]);
   
  }  
      
   
}