
import java.util.Scanner;
import java.lang.Math;
import java.util.*;

public class CalculateWind{
 
   // calculate the windSpeed
   
   public  double calculateWindChill(double temp, double windSpeed){
	   
	    double windchill = 35.74 + 0.6215 * temp + (0.4275 * temp - 35.75) * windSpeed;
	   
	    return windchill;
   }

 
  
  // main method to start the program 
   
  public static void main(String args[]){
     
	 Scanner scanner = new Scanner(System.in);
	 
	 
	 // enter the number. 
	 System.out.println("enter the temperature and windSpeed");
	 double temperature = scanner.nextInt();
     double windSpeed = scanner.nextInt(); 	 
	 
	 Main obj = new Main();
	 
	 double  windchill = obj.calculateWindChill(temperature , windSpeed);
	 
    
	  
	  System.out.println("The wind chill temperature is " + windchill);
   
  }  
      
   
}