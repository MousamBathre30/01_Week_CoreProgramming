import java.util.Scanner;


public class NaturalNumberSum{
	
	public static void main(String args[]){
	   // taking input of different number 
	   
	   Scanner scanner = new Scanner(system.in);
	   int number1 = scanner.nextInt();
	   int number2 = scanner.nextInt();
	   int number3 = scanner.nextInt();
	   
	   // check if number1 is bigger than both numbers then YES otherwise NO
	   
	   if(number1 > number2 && number2 > number3){ 
	        System.out.println("is the first number the largest != yes ");
	   } else{
		   System.out.println("is the first number the largest != NO ");
	   }
	   // check if number2 is bigger than both numbers then YES otherwise NO

	   if(number2 > number1 && number2 > number3){ 
	        System.out.println("is the second number the largest != yes ");
	   } else{
		   System.out.println("is the second number the largest != NO ");
	   }
	   
	  // check if number3 is bigger than both numbers then YES otherwise NO

	   if(number3 > number1 && number3 > number1){ 
	        System.out.println("is the second number the largest != yes ");
	   } else{
		   System.out.println("is the second number the largest != NO ");
	   }
	   
	   scanner.close();
	}
}


