	  System.out.println(ans);
  }

*/
 public static void main(String args[]){
   
   Scanner scanner = new Scanner(System.in);
   
   String str1 = scanner.nextLine();
   
   String str2 = scanner.nextLine();
   
   // mousam - > j  
   
    angram(str1 , str2);
   // replace(str1,str2);
 
 }
}